# Realtime audio service
CLOUDFLARE_REALTIME_APP_ID=
CLOUDFLARE_REALTIME_APP_SECRET=
CLOUDFLARE_REALTIME_BASE_URL=
# Public backend URL reachable from the realtime adapter.
VOICE_BRIDGE_PUBLIC_BASE_URL=

# Frontend build-time API endpoint. Put the real value in local env or hosting env vars.
VITE_API_BASE_URL=

# Voice model
GEMINI_API_KEY=your-ai-studio-api-key
GEMINI_LIVE_MODEL=gemini-3.1-flash-live-preview
DISCUSSION_COLLABORATIVE_VOICE=Leda
DISCUSSION_LOGICAL_VOICE=Charon

# Prompt config. Keep real prompt JSON in a secret store or an ignored local file.
ROLETALK_PROMPTS_FILE=backend/prompts.local.json
ROLETALK_PROMPTS_JSON=

# 音声認識・会話の言語ヒント（BCP-47）。未設定時は ja-JP。
GEMINI_LIVE_LANGUAGE=ja-JP
# VAD（話者区間検出）。TURN_INCLUDES_ALL_INPUT は語頭欠け・分断を抑えやすい。
GEMINI_VAD_TURN_COVERAGE=TURN_INCLUDES_ALL_INPUT
# ターン終了とみなす無音長(ms)。長くすると熟考の間で文が分断されにくい。
GEMINI_VAD_SILENCE_MS=1000
# 検出した発話開始の手前に含める音声(ms)。
GEMINI_VAD_PREFIX_PADDING_MS=500
GEMINI_VAD_START_SENSITIVITY=START_SENSITIVITY_HIGH
GEMINI_VAD_END_SENSITIVITY=END_SENSITIVITY_LOW
GEMINI_TRANSCRIPT_NORMALIZE=1

# 音声出力・分析
GEMINI_OUTPUT_PITCH_FACTOR=0.92
VOICE_BRIDGE_SILENCE_RMS_THRESHOLD=80
PLAYBACK_INTERRUPT_RMS_THRESHOLD=250
PLAYBACK_INTERRUPT_COOLDOWN_SECONDS=1.5

# Backend logging
BACKEND_LOG_TIMEZONE=Asia/Tokyo
BACKEND_LOG_MAX_BYTES=5242880
BACKEND_LOG_BACKUP_COUNT=3

# Optional: cloud model credentials
GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/google-application-credentials.json
